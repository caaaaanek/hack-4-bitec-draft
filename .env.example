# Скопіюйте у .env і заповніть. Файл .env не комітиться.
POSTGRES_PASSWORD=
# Не коротше 32 символів, інакше API не стартує: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Ключ шифрування буфера відповідей до закриття хвилі. Порожньо: похідний від JWT_SECRET
# (тоді зміна JWT_SECRET посеред хвилі зробить відповіді в буфері нечитабельними).
POOL_ENCRYPTION_KEY=
# Або шлях до файлу з ключем (Docker secret, сховище секретів під іншою людиною, ніж адміністратор сервера):
# тоді ключа немає ні в .env, ні в змінних оточення. Має пріоритет над POOL_ENCRYPTION_KEY.
POOL_ENCRYPTION_KEY_FILE=
# Автопілот хвиль: крок кожні N секунд (0 — лише вручну)
AUTOPILOT_INTERVAL_SECONDS=
# Пароль синтетичних демо-користувачів (мінімум 8 символів)
DEMO_PASSWORD=
# Ключі джерел фактів, кожен прив'язаний до свого source. Джерела адаптерів (python -m adapters):
# artemida, atestat, training, procurement, reports, mitra (тема 2). Приклад: "artemida=довгий-ключ-1;atestat=довгий-ключ-2"
INTEGRATION_KEYS=
# Спільний ключ для будь-якого джерела (застарілий спосіб, лише для демо)
INTEGRATION_API_KEY=
# Часовий пояс для дат хвиль і подань
TIMEZONE=Europe/Kyiv
# Демо-історія при старті docker compose: дві закриті хвилі, рішення керівника й заходи
SEED_WITH_WAVES=true
# Демо-дані при старті: підрозділи «(демо)», користувачі admin/leader/staff…, факти за 18 місяців.
# false — робочий режим: лише анкети з додатків Б і В і один адміністратор admin з паролем DEMO_PASSWORD
# (змініть після входу); каталог заходів доступний завжди. SEED_DEMO=false вимикає й SEED_WITH_WAVES.
SEED_DEMO=true
# Поріг k (не менше 5)
DEFAULT_MIN_GROUP_SIZE=5
# Інтеграція з Mitra (тема 2), контракт docs/contracts/integra-mitra.yaml. Порожня адреса — вимкнено.
# THEME2_URL — їхній API для заходів (ми шлемо POST {THEME2_URL}/measures), напр. http://mitra/api/integrations/integra
# THEME2_API_KEY — спільний ключ в обидва боки (заголовок X-Integration-Key)
# THEME2_PUBLIC_URL — адреса інтерфейсу Mitra: лише туди можуть вести посилання на доказ (/verify). Порожньо — хост із THEME2_URL
# THEME2_SYNC_SECONDS — як часто надсилати чергу (0 — лише вручну). PUBLIC_URL (нижче) дає Mitra посилання «відкрити в Integra»
THEME2_URL=
THEME2_API_KEY=
THEME2_PUBLIC_URL=
THEME2_SYNC_SECONDS=10
# Опційний асистент (локальна модель через Ollama). За замовчуванням вимкнено
ASSISTANT_ENABLED=false
ASSISTANT_URL=http://localhost:11434/api/generate
ASSISTANT_MODEL=llama3.1:8b
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Підшлях за зворотним проксі, наприклад /imd (порожньо: корінь)
ROOT_PATH=
# Адреса фронтенду для одноразових посилань на анкету (/s/<токен>)
PUBLIC_URL=http://localhost:8080
# Файли-докази: розмір (байт) і кількість на пункт чек-листа
EVIDENCE_MAX_BYTES=10485760
EVIDENCE_MAX_FILES_PER_ITEM=10
# Вхід паролем (false: лише через проксі організації)
PASSWORD_LOGIN_ENABLED=true
# Вхід через довірений проксі (SSO організації): логін у заголовку від адрес TRUSTED_PROXIES
PROXY_AUTH_ENABLED=false
PROXY_AUTH_HEADER=X-Remote-User
# IP або CIDR проксі через кому, наприклад 172.16.0.0/12
TRUSTED_PROXIES=
# Необов'язковий спільний секрет, який проксі передає в X-Proxy-Secret
PROXY_AUTH_SECRET=
# Зворотний проксі перед API (nginx), від якого береться реальна IP клієнта з X-Forwarded-For (ліміти спроб входу
# й анонімних посилань). Окремо від TRUSTED_PROXIES: SSO цим не вмикається. Порожньо в compose: мережі Docker.
FORWARDED_PROXIES=
# Асистент фронтенду (/api/assistant): будь-який OpenAI-сумісний /chat/completions.
# Порожньо — асистент відповідає шаблонами правил у браузері. Ollama в закритому контурі:
#   Шлюз кафедри (Gemma, ключ видає адміністратор шлюзу): LLM_BASE_URL=https://api.csit-mitit.com/v1  LLM_MODEL=gemma4-26b
# Закритий контур: за замовчуванням модель лише за внутрішньою адресою (localhost, приватна мережа, сервіс compose).
# Для зовнішньої адреси (шлюз кафедри, свій піддомен) — true: агреговані дані вийдуть за межі контуру.
LLM_ALLOW_EXTERNAL=false
#   Своя Ollama: LLM_BASE_URL=http://host.docker.internal:11434/v1
# Self-hosted Gemma на власному сервері за шлюзом із ключем (deploy/llm/README.md):
#   LLM_BASE_URL=https://<піддомен>/v1   LLM_API_KEY=<ключ шлюзу>   LLM_MODEL=<тег Gemma>
# Якщо задано LLM_*, /api/v1/assistant/ask (ASSISTANT_ENABLED=true) теж іде в цю модель замість ASSISTANT_URL.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemma4-26b
# Скільки запитів до моделі одночасно (понад ліміт — 429, фронтенд відповідає шаблонами)
LLM_MAX_CONCURRENT=4
# ---------- Ролі й розподіл обов'язків ----------
# Хто підтверджує пункти чек-листа: уповноважений (commissioner) і/або внутрішній аудит (auditor)
CHECKLIST_CONFIRMERS=commissioner,auditor
# true: людьми й підрозділами керує лише технічний адміністратор (coordinator), уповноважений (admin) — лише хвилі
SEPARATE_TECH_ADMIN=false
# Як називати кореневу одиницю в текстах: institution (заклад), organization (організація), unit (військова частина)
ORG_KIND=institution
# false (рекомендовано): керівник бачить деталі лише свого підрозділу, про дочірні — розподіл рівнів без назв
LEADER_CHILD_DETAILS=false
# ---------- Облікові записи ----------
# false (рекомендовано в роботі): пароль ставить сама людина за одноразовим запрошенням
ADMIN_SETS_PASSWORDS=true
INVITE_TTL_HOURS=72
# true (рекомендовано в роботі): привілейовані ролі, зміну категорії, нові облікові записи й відкриття хвилі
# підтверджує друга людина (POST /api/v1/admin/approvals/{id}/approve)
FOUR_EYES_ENABLED=false
# ---------- Анонімність ----------
# true: особовий склад проходить лише за QR чи одноразовими посиланнями (логін — для РГ, експертів, керівників)
STAFF_TOKEN_ONLY=false
# Детектор відвертості: мінімум відповідей на кожен варіант непрямого питання (і не менше k)
CANDOR_MIN_PER_VARIANT=30
# ---------- Зовнішні джерела ----------
# Закритий контур = без обов'язкової залежності від зовнішніх сервісів, а не «без інтернету».
# true: живі Prozorro й реєстр декларацій НАЗК у модулі «Перевірки» (необов'язкові, недоступність нічого не ламає)
EXTERNAL_FETCH_ENABLED=true
# Перевірка контрагентів (пункт 4.5.1): API на кшталт Youcontrol. Порожньо — синтетичний мок
COUNTERPARTY_API_URL=
COUNTERPARTY_API_KEY=
