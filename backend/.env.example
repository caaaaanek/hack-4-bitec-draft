# Для локального запуску без Docker. Скопіюйте у backend/.env
DATABASE_URL=postgresql+psycopg://imd:imd@localhost:5432/imd
# Не коротше 32 символів: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
DEMO_PASSWORD=
# Ключі джерел фактів, кожен прив'язаний до свого source: "artemida=ключ1;atestat=ключ2"
INTEGRATION_KEYS=
# Спільний ключ для будь-якого джерела (застарілий спосіб, лише для демо)
INTEGRATION_API_KEY=
# Часовий пояс для дат хвиль і подань
TIMEZONE=Europe/Kyiv
# Поріг k (не менше 5)
DEFAULT_MIN_GROUP_SIZE=5
# Інтеграція з темою 2: адреса їхнього API і ключ (порожньо — вимкнено)
THEME2_URL=
THEME2_API_KEY=
# Опційний асистент (локальна модель через Ollama). За замовчуванням вимкнено
ASSISTANT_ENABLED=false
ASSISTANT_URL=http://localhost:11434/api/generate
ASSISTANT_MODEL=llama3.1:8b
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Підшлях за зворотним проксі, наприклад /imd (порожньо: корінь)
ROOT_PATH=
# Адреса фронтенду для одноразових посилань на анкету (/s/<токен>)
PUBLIC_URL=http://localhost:8080
# Каталог зібраного фронтенду: API сам віддає сторінки на своєму порту (../run-local.sh задає це сам).
# Тоді й PUBLIC_URL має бути адресою API, наприклад http://localhost:8000
FRONTEND_DIST=
# Файли-докази: розмір (байт) і кількість на пункт чек-листа
EVIDENCE_MAX_BYTES=10485760
EVIDENCE_MAX_FILES_PER_ITEM=10
EVIDENCE_DIR=./data/evidence
# Вхід паролем (false: лише через проксі організації)
PASSWORD_LOGIN_ENABLED=true
# Вхід через довірений проксі (SSO організації): логін у заголовку від адрес TRUSTED_PROXIES
PROXY_AUTH_ENABLED=false
PROXY_AUTH_HEADER=X-Remote-User
# IP або CIDR проксі через кому, наприклад 172.16.0.0/12
TRUSTED_PROXIES=
# Необов'язковий спільний секрет, який проксі передає в X-Proxy-Secret
PROXY_AUTH_SECRET=
# Зворотний проксі перед API (nginx), від якого береться реальна IP клієнта з X-Forwarded-For (ліміти спроб входу
# й анонімних посилань). Окремо від TRUSTED_PROXIES: SSO цим не вмикається. Порожньо в compose: мережі Docker.
FORWARDED_PROXIES=
# Асистент фронтенду (/api/assistant): будь-який OpenAI-сумісний /chat/completions.
# Порожньо — асистент відповідає шаблонами правил у браузері. Ollama в закритому контурі:
#   Шлюз кафедри (Gemma, ключ видає адміністратор шлюзу): LLM_BASE_URL=https://api.csit-mitit.com/v1  LLM_MODEL=gemma4-26b
#   Своя Ollama: LLM_BASE_URL=http://host.docker.internal:11434/v1
# Self-hosted Gemma на власному сервері за шлюзом із ключем (deploy/llm/README.md):
#   LLM_BASE_URL=https://<піддомен>/v1   LLM_API_KEY=<ключ шлюзу>   LLM_MODEL=<тег Gemma>
# Якщо задано LLM_*, /api/v1/assistant/ask (ASSISTANT_ENABLED=true) теж іде в цю модель замість ASSISTANT_URL.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemma4-26b
# Демо-дані при старті: підрозділи «(демо)», користувачі admin/leader/staff…, факти за 18 місяців.
# false — робочий режим: лише анкети з додатків Б і В і один адміністратор admin з паролем DEMO_PASSWORD
# (змініть після входу); каталог заходів доступний завжди. SEED_DEMO=false вимикає й SEED_WITH_WAVES.
SEED_DEMO=true

# Живі запити «Перевірок» до Prozorro і НАЗК. У закритому контурі лишити false.
EXTERNAL_FETCH_ENABLED=false
