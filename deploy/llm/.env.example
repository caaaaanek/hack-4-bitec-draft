# Скопіюйте у .env і заповніть. Файл .env не комітиться.
# Ключ шлюзу. Той самий рядок задається в LLM_API_KEY основного застосунку:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
LLM_API_KEY=
# Тег моделі в Ollama. Перевірте точну назву Gemma в бібліотеці Ollama перед pull.
LLM_MODEL=
# Порт шлюзу на сервері (HTTPS робить зворотний проксі хоста перед ним)
GATEWAY_PORT=8080
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_KEEP_ALIVE=24h
